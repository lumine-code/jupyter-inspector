{
  "atom-workspace": {
    "alt-j i": "jupyter-inspector:toggle-focus"
  },

  "atom-workspace atom-text-editor.inspector-expression:not([mini])": {
    "enter": "core:confirm",
    "shift-enter": "editor:newline",
    "escape": "core:cancel",
    "tab": "jupyter-inspector:focus-body",
    "shift-tab": "jupyter-inspector:focus-body"
  },

  "atom-workspace .jupyter-inspector .inspector-body": {
    "up": "jupyter-inspector:scroll-up",
    "down": "jupyter-inspector:scroll-down",
    "tab": "jupyter-inspector:focus-expression",
    "shift-tab": "jupyter-inspector:focus-expression"
  }
}
