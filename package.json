{
  "name": "jupyter-inspector",
  "author": "lumine-code",
  "description": "Introspect the expression under the cursor with a Jupyter kernel.",
  "repository": "https://github.com/lumine-code/jupyter-inspector",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-inspector/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-inspector#readme",
  "keywords": [
    "introspection",
    "docstring",
    "signature",
    "ipython",
    "python"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "configSchema": {
    "fontSize": {
      "title": "Font size",
      "description": "Font size of the inspection result. Zero follows the editor.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "jupyter-inspector/InspectorPane": "deserializeInspectorPane"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "jupyter.kernel": {
      "versions": {
        "^1.0.0": "consumeJupyterKernel"
      }
    },
    "autocomplete.watch-editor": {
      "versions": {
        "^1.0.0": "consumeAutocompleteWatchEditor"
      }
    },
    "jupyter.output": {
      "versions": {
        "^1.0.0": "consumeJupyterOutput"
      }
    },
    "jupyter.context": {
      "versions": {
        "^1.0.0": "consumeJupyterContext"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#74fb2ef3e049ea45ab3b826d2f74722d5e998bd3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
