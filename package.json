{
  "name": "jupyter-inspector",
  "author": "lumine-code",
  "description": "Introspect the expression under the cursor with a Jupyter kernel.",
  "repository": "https://github.com/lumine-code/jupyter-inspector",
  "bugs": {
    "url": "https://github.com/lumine-code/jupyter-inspector/issues"
  },
  "homepage": "https://github.com/lumine-code/jupyter-inspector#readme",
  "keywords": [
    "introspection",
    "docstring",
    "signature",
    "ipython",
    "python"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can look up the documentation for whatever is under the cursor with {{ 'jupyter-inspector:inspect' | keystroke }}"
  ],
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "activationCommands": {
    "lumine-workspace": [
      "jupyter-inspector:toggle-focus",
      "jupyter-inspector:inspect"
    ]
  },
  "configSchema": {
    "fontSize": {
      "title": "Font size",
      "description": "Font size of the inspection result. Zero follows the editor.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "jupyter.kernel": {
      "versions": {
        "^1.0.0": "consumeJupyterKernel"
      }
    },
    "autocomplete.watch-editor": {
      "versions": {
        "^1.0.0": "consumeAutocompleteWatchEditor"
      }
    },
    "jupyter.output": {
      "versions": {
        "^1.0.0": "consumeJupyterOutput"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#df06b3fca2ec49b1d6b76cb8af3e9f5015a2612c"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
